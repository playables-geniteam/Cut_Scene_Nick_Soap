# ============================================
# Cocos Creator .gitignore
# Works for Cocos Creator 2.x and 3.x
# ============================================

# --- Cocos Creator generated / cache ---
library/
build/

# Native engine builds (regenerated by the editor)
native/

# --- Node / tooling ---
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json.bak

# --- Build output archives ---
*.zip
*.7z
*.rar

# --- OS junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~

# --- Logs ---
*.log
logs/

# --- Optional: Blender / source art working files ---
# Uncomment if you keep raw art outside the repo
# *.blend1
# *.psd

# ============================================
# IMPORTANT — DO NOT IGNORE THESE:
#   assets/          (all your content)
#   assets/**/*.meta (asset UUIDs — breaking these
#                     breaks every scene/prefab ref)
#   settings/
#   extensions/      (custom editor extensions)
#   package.json
#   project.json     (Cocos Creator 2.x only)
# ============================================
